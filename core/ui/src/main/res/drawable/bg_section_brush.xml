<?xml version="1.0" encoding="utf-8"?>
<!-- Figma "Brush": 4x20 gradient bar in front of section titles. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="@color/sf_gradient_center"
        android:centerY="0.48"
        android:endColor="@color/sf_gradient_end"
        android:startColor="@color/sf_gradient_start"
        android:type="linear" />
    <corners
        android:bottomRightRadius="2dp"
        android:topRightRadius="2dp" />
    <size
        android:width="4dp"
        android:height="20dp" />
</shape>
