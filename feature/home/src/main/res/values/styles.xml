<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Pill tab under the Home header (For You, New, ...). -->
    <style name="Widget.ShortFilm.HomeTab" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:background">@drawable/bg_home_tab</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textAppearance">@style/TextAppearance.ShortFilm.Tab</item>
        <item name="android:textColor">@color/home_tab_text</item>
    </style>

    <style name="Widget.ShortFilm.HeaderButton" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_header_button</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- Section heading with the gradient brush in front. -->
    <style name="Widget.ShortFilm.SectionTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAppearance">@style/TextAppearance.ShortFilm.Subtitle1</item>
        <item name="drawableStartCompat">@drawable/bg_section_brush</item>
    </style>

    <style name="ShapeAppearance.ShortFilm.Card" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.ShortFilm.Poster" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>
</resources>
